# ==============================================================================
# TALENTECHNO BACKEND & ADMIN PORTAL CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# 1. ANTI-GOBUSTER & SCANNER DEFENSE (SECURITY THROUGH OBSCURITY + SHIELD)
# ------------------------------------------------------------------------------
# The secret URL slug where the admin panel is mounted.
# Attackers running gobuster on /admin, /wp-admin, /login will hit honeypot 404s.
ADMIN_SECRET_ROUTE=/_tg_gate_7a92b

# Optional secret access token required as a query param or header for first entry
# e.g.: http://localhost:5000/_tg_gate_7a92b?token=talen_sec_key_2026
ADMIN_ACCESS_GATE_TOKEN=talen_sec_key_2026

# Decoy Honeypot mode: 'realistic_404', 'tarpit_delay', or 'fake_apache'
HONEYPOT_MODE=tarpit_delay

# ------------------------------------------------------------------------------
# 2. SEPARATE ADMIN EMAIL AUTHENTICATION
# ------------------------------------------------------------------------------
# Dedicated admin email (completely separate from general hrteam@talentechno.com)
ADMIN_EMAIL=security.admin@talentechno.com

# Master password or security passphrase for the admin email
ADMIN_PASSWORD=TalentechnoSecure2026!

# JWT Secret for admin session cookies/bearer tokens
JWT_SECRET=super_secret_jwt_talentechno_random_key_9948271635

# OTP / Magic Link mode ('console_preview' in local dev, or 'smtp_mailer' in prod)
AUTH_OTP_MODE=console_preview

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from: https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (FOR IMAGES & ASSETS)
# ------------------------------------------------------------------------------
# Obtain from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id-here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key-here
CLOUDFLARE_R2_BUCKET_NAME=talentechno-media
# The public URL prefix (e.g., https://pub-xxxxxxxx.r2.dev or https://assets.talentechno.com)
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-your-bucket-id.r2.dev
